// switch

let day = 7;
let dayName;

switch (day) {
  case 0:
    dayName = "lunes";
    break;
  case 1:
    dayName = "martes";
    break;
  case 2:
    dayName = "miercoles";
    break;
  case 3:
    dayName = "jueves";
    break;
  case 4:
    dayName = "viernes";
    break;
  case 5:
    dayName = "sabado";
    break;
  case 6:
    dayName = "domingo";

  default:
    dayName = "numero de dia incorrecto";
}

console.log("el dia es: " + dayName);

